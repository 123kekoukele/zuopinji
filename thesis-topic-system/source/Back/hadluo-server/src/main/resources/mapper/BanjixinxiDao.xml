<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.hadluo.dao.BanjixinxiDao">

	<resultMap type="com.hadluo.entity.BanjixinxiEntity" id="banjixinxiMap">
		<result property="banjimingcheng" column="banjimingcheng"/>
	</resultMap>

    <select id="selectListView"
		resultType="com.hadluo.entity.view.BanjixinxiView" >
		SELECT banjixinxi.* FROM banjixinxi banjixinxi
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.hadluo.entity.view.BanjixinxiView" >
		SELECT * FROM banjixinxi banjixinxi
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
</mapper>

