<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.hadluo.dao.DaibanxinxiDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.hadluo.entity.DaibanxinxiEntity" id="daibanxinxiMap">
        <result property="xuehao" column="xuehao"/>
        <result property="xueshengxingming" column="xueshengxingming"/>
        <result property="biaoti" column="biaoti"/>
        <result property="neirong" column="neirong"/>
        <result property="tixingshijian" column="tixingshijian"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.hadluo.entity.view.DaibanxinxiView" >

		SELECT  daibanxinxi.* FROM daibanxinxi  daibanxinxi 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.hadluo.entity.view.DaibanxinxiView" >
		SELECT * FROM daibanxinxi  daibanxinxi <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	

</mapper>
